# Copy to backend/.env and replace the placeholders. Never commit the real .env.

# HTTP port inside the container (docker-compose publishes HOST_PORT -> 8080).
PORT=8080
HOST_PORT=8080

# HS256 signing secret, at least 32 characters. Generate e.g. with: openssl rand -base64 48
# If unset the server generates a random one at startup and tokens do not survive a restart.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# PostgreSQL (docker-compose sets DATABASE_URL to the bundled db service).
# Leave DATABASE_URL unset when running locally without a database -> in-memory store.
# DATABASE_URL=jdbc:postgresql://localhost:5432/lexiflow
DB_USER=lexiflow
DB_PASSWORD=replace-with-a-strong-db-password

# AI proxy: "anthropic" or "none" (default). With "none" the /v1/ai/* routes return 503.
AI_PROVIDER=none
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback (fallbacks: "default"); set to "off" to disable.
# ANTHROPIC_FALLBACKS=default

# Per-user limit for the /v1/ai/* routes (requests per minute).
RATE_LIMIT_AI_PER_MINUTE=20

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
