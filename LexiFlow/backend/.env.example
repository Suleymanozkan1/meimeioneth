# Copy to backend/.env and replace the placeholders. Never commit the real .env.

# HTTP port inside the container (docker-compose publishes HOST_PORT -> 8080).
PORT=8080
HOST_PORT=8080

# HS256 signing secret: at least 32 random characters. Generate one with: openssl rand -base64 48
# The server refuses placeholder or low-entropy values. Left empty, it generates a random secret at startup
# (fine for a throwaway local run, but tokens then do not survive a restart).
JWT_SECRET=

# PostgreSQL (docker-compose sets DATABASE_URL to the bundled db service).
# Leave DATABASE_URL unset when running locally without a database -> in-memory store.
# DATABASE_URL=jdbc:postgresql://localhost:5432/lexiflow
DB_USER=lexiflow
DB_PASSWORD=replace-with-a-strong-db-password

# AI proxy: "anthropic" or "none" (default). With "none" the /v1/ai/* routes return 503.
AI_PROVIDER=none
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback (fallbacks: "default"); set to "off" to disable.
# ANTHROPIC_FALLBACKS=default

# Limits for the /v1/ai/* routes (requests per minute): per player, per client address (all accounts
# together) and for the whole server (counts every model call, including corrective retries).
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_AI_PER_SOURCE_PER_MINUTE=60
RATE_LIMIT_AI_GLOBAL_PER_MINUTE=300
# Anonymous registrations per minute per client address.
RATE_LIMIT_REGISTER_PER_MINUTE=10

# Accept the battle token as ?token= for old app versions (1.0/1.1). Off by default: URLs end up in logs.
# ALLOW_WS_QUERY_TOKEN=false

# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
